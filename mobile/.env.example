# Firebase Web app config (Firebase Console -> Project settings -> Your apps)
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id

# Backend URL: use 10.0.2.2 for Android emulator, localhost for web,
# or your computer's LAN IP for a physical device.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Optional: Google OAuth client IDs (email/password works without these)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
